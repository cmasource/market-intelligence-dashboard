NEXT_PUBLIC_APP_NAME=CMA Markets
# Supabase Auth (public browser-safe values; never use service_role here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only alert scheduler credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random value of at least 16 characters; Vercel sends it as a Bearer token to the cron route.
CRON_SECRET=
# Canonical app URL used in confirmation and recovery emails.
# Local example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
TWELVE_DATA_API_KEY=
PPI_API_KEY=
PPI_API_SECRET=
PPI_CLIENT_KEY=
PPI_AUTHORIZED_CLIENT=API_CLI_REST
# PPI_ENV controls which credentials are used: sandbox or production.
PPI_ENV=sandbox
# Optional. Leave empty to use the default URL for the selected PPI_ENV.
PPI_BASE_URL=
PPI_PROD_API_KEY=
PPI_PROD_API_SECRET=
PPI_PROD_CLIENT_KEY=
PPI_PROD_AUTHORIZED_CLIENT=API_CLI_REST
BYMA_API_KEY=
BYMA_BASE_URL=https://apigw.byma.com.ar
BYMA_CLIENT_ID=
BYMA_CLIENT_SECRET=
BYMA_SCOPE=snapshot.read eod.read delay20.read
BYMA_DEFAULT_FEED=delay20
# Optional Docta Capital bond analytics API. Requires OAuth client credentials from Docta.
DOCTA_API_BASE_URL=https://api.doctacapital.com.ar
DOCTA_CLIENT_ID=
DOCTA_CLIENT_SECRET=
BINANCE_BASE_URL=https://api.binance.com
NEWS_PROVIDER=fallback
MARKET_DATA_PROVIDER=yahoo_fallback
# Optional asset logo provider. Supported value: logo-dev.
# Logo.dev uses NEXT_PUBLIC_LOGO_DEV_TOKEN. Use a public/publishable token only.
# Set NEXT_PUBLIC_ENABLE_EXTERNAL_LOGOS=1 only after confirming the token works.
NEXT_PUBLIC_ASSET_LOGO_PROVIDER=
NEXT_PUBLIC_ENABLE_EXTERNAL_LOGOS=
NEXT_PUBLIC_LOGO_DEV_TOKEN=
# AI_PROVIDER_API_KEY=
# DATABASE_URL=
