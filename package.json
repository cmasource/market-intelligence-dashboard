{
  "name": "market-intelligence-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit:i18n": "tsx scripts/audit-visible-english.ts",
    "validate:finance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-financial-engine.ts",
    "validate:argentina": "tsx scripts/validate-argentina-data.ts",
    "validate:coverage": "tsx scripts/validate-public-asset-coverage.ts",
    "test:technical": "node --import tsx --test tests/technical/*.test.ts tests/market-data/*.test.ts tests/api/*.test.ts tests/intelligence/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
